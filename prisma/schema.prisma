generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  role               Role               @default(STUDENT)
  avatar             String?
  status             String             @default("active")
  lastActivity       DateTime           @default(now())
  gems               Int                @default(0)
  lives              Int                @default(3)
  streak             Int                @default(0)
  xp                 Int                @default(0)
  email              String?            @unique
  emailVerified      DateTime?
  image              String?
  classroomId        String?
  schoolId           String?
  activeFrame        String?
  activeSessionToken String?
  teacherOwnerId     String?
  studentCode        String?            @unique
  password           String?
  apiCalls           Int                @default(0)
  avatarX            Float              @default(70)
  avatarY            Float              @default(65)
  lastSeen           DateTime           @default(now())
  accounts           Account[]
  buffsReceived      Buff[]
  ownedClassrooms    Classroom[]        @relation("ClassroomTeacher")
  evidenceEntries    EvidenceEntry[]
  ownedGrades        Grade[]            @relation("GradeTeacher")
  hints              Hint[]
  inventory          Inventory[]
  progress           Progress[]
  projectGrades      ProjectGrade[]     @relation("StudentProjectGrades")
  raidContributions  RaidContribution[]
  sessions           Session[]
  studentMissions    StudentMission[]
  supportTicketsSent SupportTicket[]    @relation("UserSupportTickets")
  sentMessages       TeacherMessage[]   @relation("SentMessages")
  classroom          Classroom?         @relation("ClassroomStudents", fields: [classroomId], references: [id])
  school             School?            @relation(fields: [schoolId], references: [id])
  teacherOwner       User?              @relation("TeacherStudents", fields: [teacherOwnerId], references: [id])
  ownedStudents      User[]             @relation("TeacherStudents")
  achievements       UserAchievement[]
  virtualRoom        VirtualRoom?
  createdWorlds      World[]            @relation("TeacherWorlds")
  receivedMessages   TeacherMessage[]   @relation("MessageRecipients")
  assignedWorlds     World[]            @relation("StudentAssignedWorlds")

  // Dojo Features Relations
  behaviorLogsReceived BehaviorLog[]    @relation("BehaviorLogStudent")
  behaviorLogsGiven    BehaviorLog[]    @relation("BehaviorLogTeacher")
  parentChildren       ParentChild[]    @relation("ParentUser")
  childParents         ParentChild[]    @relation("ChildUser")
  classStoryPosts      ClassStoryPost[] @relation("ClassStoryTeacher")
  portfolioItems       PortfolioItem[]  @relation("PortfolioStudent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model School {
  id                 String             @id @default(cuid())
  name               String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  maxMaps            Int                @default(1)
  maxStudents        Int                @default(25)
  subscriptionPlan   SubscriptionPlan   @default(BASIC)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  apiCalls           Int                @default(0)
  paymentDay         Int                @default(1)
  nextPaymentDate    DateTime?
  classrooms         Classroom[]
  grades             Grade[]
  raidBosses         RaidBoss[]
  messages           TeacherMessage[]
  users              User[]
  worlds             World[]
}

model World {
  id               String           @id @default(cuid())
  title            String
  theme            String
  daysJson         String
  createdAt        DateTime         @default(now())
  pedagogyJson     String?
  schoolId         String?
  teacherId        String?
  evidenceEntries  EvidenceEntry[]
  progress         Progress[]
  projectGrades    ProjectGrade[]   @relation("WorldProjectGrades")
  studentMissions  StudentMission[]
  school           School?          @relation(fields: [schoolId], references: [id])
  teacher          User?            @relation("TeacherWorlds", fields: [teacherId], references: [id])
  classrooms       Classroom[]      @relation("ClassroomToWorld")
  assignedStudents User[]           @relation("StudentAssignedWorlds")
}

model EvidenceEntry {
  id              String   @id @default(cuid())
  studentId       String
  worldId         String
  levelId         Int
  studentAnswer   String
  isCorrect       Boolean
  feedback        String
  topic           String?
  emotionDetected String?
  createdAt       DateTime @default(now())
  imageUrl        String?
  status          String   @default("COMPLETED")
  canAdvance      Boolean  @default(true)
  grade           Int?
  attempts        Int      @default(1)
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  world           World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
}

model Progress {
  id        String   @id @default(cuid())
  studentId String
  worldId   String
  levelId   Int
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([studentId, worldId, levelId])
}

model Inventory {
  id        String   @id @default(cuid())
  studentId String
  itemId    String
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, itemId])
}

model Achievement {
  id          String            @id @default(cuid())
  name        String
  description String
  icon        String
  condition   String
  xpReward    Int               @default(0)
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  studentId     String
  achievementId String
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
}

model RaidBoss {
  id            String             @id @default(cuid())
  name          String
  imageUrl      String?
  maxHealth     Int
  currentHealth Int
  status        String             @default("ACTIVE")
  createdAt     DateTime           @default(now())
  schoolId      String?
  school        School?            @relation(fields: [schoolId], references: [id])
  contributions RaidContribution[]
}

model RaidContribution {
  id          String   @id @default(cuid())
  raidBossId  String
  studentId   String
  damageDealt Int
  createdAt   DateTime @default(now())
  raidBoss    RaidBoss @relation(fields: [raidBossId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Hint {
  id        String   @id @default(cuid())
  studentId String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Buff {
  id         String   @id @default(cuid())
  targetId   String
  fromName   String
  fromAvatar String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  target     User     @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model StudentMission {
  id        String   @id @default(cuid())
  studentId String
  worldId   String
  daysJson  String
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([studentId, worldId])
}

model Grade {
  id          String      @id @default(cuid())
  name        String
  teacherId   String
  createdAt   DateTime    @default(now())
  description String?
  schoolId    String?
  classrooms  Classroom[]
  school      School?     @relation(fields: [schoolId], references: [id])
  teacher     User        @relation("GradeTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  emoji       String   @default("📚")
  teacherId   String
  createdAt   DateTime @default(now())
  gradeId     String?
  description String?
  schoolId    String?
  accessCode  String?  @unique
  grade       Grade?   @relation(fields: [gradeId], references: [id])
  school      School?  @relation(fields: [schoolId], references: [id])
  teacher     User     @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  students    User[]   @relation("ClassroomStudents")
  worlds      World[]  @relation("ClassroomToWorld")
}

model AIPromptCache {
  id        String   @id @default(cuid())
  topic     String
  theme     String
  response  String
  createdAt DateTime @default(now())

  @@unique([topic, theme])
  @@index([topic, theme])
}

model TeacherMessage {
  id         String   @id @default(cuid())
  senderId   String
  schoolId   String
  message    String
  isGlobal   Boolean  @default(false)
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipients User[]   @relation("MessageRecipients")
}

model SupportTicket {
  id         String   @id @default(cuid())
  senderId   String
  message    String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  adminReply String?
  sender     User     @relation("UserSupportTickets", fields: [senderId], references: [id], onDelete: Cascade)
}

model ProjectGrade {
  id        String   @id @default(cuid())
  studentId String
  worldId   String
  grade     Float
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   User     @relation("StudentProjectGrades", fields: [studentId], references: [id], onDelete: Cascade)
  world     World    @relation("WorldProjectGrades", fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([studentId, worldId])
}

model VirtualRoom {
  id        String               @id @default(cuid())
  studentId String               @unique
  theme     String               @default("basic_room")
  furniture FurniturePlacement[]
  student   User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FurniturePlacement {
  id        String      @id @default(cuid())
  roomId    String
  itemId    String
  positionX Float
  positionY Float
  positionZ Float       @default(0)
  rotation  Float       @default(0)
  room      VirtualRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

enum Role {
  TEACHER
  STUDENT
  SUPERADMIN
  PARENT
}

enum SubscriptionPlan {
  BASIC
  INTERMEDIATE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
}

// --- DOJO FEATURES MODELS ---

model ParentChild {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  createdAt DateTime @default(now())

  parent    User     @relation("ParentUser", fields: [parentId], references: [id], onDelete: Cascade)
  child     User     @relation("ChildUser", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

model BehaviorCategory {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("⭐") // Emoji for the category
  weight      Int      @default(1)    // e.g., 1 for positive, -1 for negative
  isPositive  Boolean  @default(true)
  teacherId   String?  // If null, it's a global category. If set, specific to a teacher.
  createdAt   DateTime @default(now())

  logs        BehaviorLog[]
}

model BehaviorLog {
  id          String   @id @default(cuid())
  studentId   String
  teacherId   String
  categoryId  String
  note        String?
  createdAt   DateTime @default(now())

  student     User             @relation("BehaviorLogStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher     User             @relation("BehaviorLogTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  category    BehaviorCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

model ClassStoryPost {
  id          String   @id @default(cuid())
  teacherId   String
  classroomId String?  // If null, it's a global school post
  content     String
  imageUrl    String?
  createdAt   DateTime @default(now())

  teacher     User     @relation("ClassStoryTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  // Optionally relate to classroom
}

model PortfolioItem {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  content     String?
  imageUrl    String?
  status      String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())

  student     User     @relation("PortfolioStudent", fields: [studentId], references: [id], onDelete: Cascade)
}
