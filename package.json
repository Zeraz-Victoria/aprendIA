{
  "name": "aprendia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run clean-port && NODE_OPTIONS='--max-old-space-size=2048' next dev",
    "clean-port": "lsof -ti:3000 | xargs kill -9 || true",
    "build": "prisma generate && prisma migrate deploy && NODE_OPTIONS=--max-old-space-size=1024 next build",
    "start": "NODE_OPTIONS='--max-old-space-size=450' next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^8.8.0",
    "@tailwindcss/typography": "^0.5.19",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lightningcss": "^1.32.0",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "next": "15.3.1",
    "next-auth": "^4.24.13",
    "pdfkit": "^0.17.2",
    "pusher": "^5.3.2",
    "pusher-js": "^8.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.33",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
